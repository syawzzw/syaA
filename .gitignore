# IDE
.idea/
.vscode/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# 数据库临时文件（syaA.db 本身需要提交，以同步数据到其他设备）
*.db-journal
*.db-wal

# 运行时配置（含本地路径）
gui_config.json

# 逆地理编码缓存（可随时重建）
src/tools/.geo_cache.json

# 输出目录（爬虫产物，体积巨大）
output/
src/url/output/

# 可执行文件
*.exe

# WorkBuddy（保留 memory 目录，便于跨设备同步工作上下文）
.workbuddy/*
!.workbuddy/memory/

# 日志
*.log

# 外源参考素材（第三方项目副本 + 原始压缩包，仅本地参考，不入库）
外源/

# 临时文件
overview.md
test_performer.py
test_performer_result.txt
*.spec
